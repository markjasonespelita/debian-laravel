#!/bin/sh
set -e

PACKAGE_NAME="zyphor"

case "$1" in
    configure)
        for path in \
            "/usr/bin/$PACKAGE_NAME" \
            "/usr/lib/$PACKAGE_NAME"
        do
            if [ -e "$path" ]; then
                chown -R root:root "$path"
            fi
        done

        for path in \
            "/usr/bin/$PACKAGE_NAME" \
            "/usr/lib/$PACKAGE_NAME" \
            "/usr/lib/$PACKAGE_NAME/scripts"
        do
            if [ -e "$path" ]; then
                chmod 755 "$path"
            fi
        done
        ;;
esac

exit 0